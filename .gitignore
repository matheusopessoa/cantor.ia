# .gitignore — cantor.ia (monorepo pnpm: apps/api + apps/web)
# Padrões sem "/" no início valem em qualquer nível (raiz e apps/*).
# ATENÇÃO: specs/ é versionado de propósito (SDD) — não adicionar aqui.

# ─── Sistema operacional ─────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
Icon?
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.DocumentRevisions-V100
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ─── Segredos e variáveis de ambiente ────────────────────────────────
.env
.env.*
*.env
# Exceções versionadas: exemplos sem segredos e o env da suíte de testes
# (lido por apps/api/vitest.config.ts — só valores de teste, nunca segredos reais).
!.env.example
!.env.sample
!apps/api/.env.test
.cm-config.json
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
secrets/
credentials*.json
service-account*.json
.npmrc
.netrc

