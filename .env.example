# .env.example — catálogo de TODAS as variáveis de ambiente do cantor.ia.
#
# Setup: `corepack pnpm env:init` copia este arquivo para `.env` (na raiz, ignorado pelo Git)
# e gera os segredos. Nunca coloque valores reais aqui.
#
# Os valores abaixo servem para rodar os apps no host (localhost). No Docker Compose, os
# endereços entre containers (db, api, worker) são definidos no próprio compose.
#
# Convenção de nomes: AGENTS.md §11.

# ─── Postgres de dev (lido por docker-compose.dev.yml) ──────────────────────────
POSTGRES_USER=cantor
POSTGRES_PASSWORD=cantor
POSTGRES_DB=cantor_dev

# ─── API (validado em apps/api/src/config/env.ts) ───────────────────────────────
# Conexão do Prisma. Precisa bater com POSTGRES_* acima (o .env não faz interpolação).
DATABASE_URL=postgresql://cantor:cantor@localhost:5432/cantor_dev?schema=public

# Segredo de assinatura dos JWT. Obrigatório, ≥ 32 caracteres. Gerado pelo env:init
# (ou: openssl rand -hex 32).
JWT_SIGN_SECRET=

# Segredo do blind index de e-mail. Obrigatório, ≥ 32 caracteres. Gerado pelo env:init.
# ATENÇÃO: trocar este valor invalida a busca de todos os e-mails já cadastrados.
EMAIL_BINDEX_SECRET=

# Origens liberadas no CORS, separadas por vírgula. Só é usada (e obrigatória) em prod:
# em dev e test a API aceita qualquer origem.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Endereço do worker de pitch (apps/worker), chamado só pela API. Opcional: este é o
# padrão para rodar no host. No compose vira http://worker:8000.
WORKER_URL=http://localhost:8000

# Provedor de letras sincronizadas (LRCLIB). Opcional: só mude para apontar a um espelho.
LRCLIB_BASE_URL=https://lrclib.net

# Token de serviço das rotas /api/review/* (revisão da letra pelo Claude Code via MCP,
# sdd-012). Lido pela API e pelo apps/mcp. Opcional: sem ele a revisão fica desligada (503).
# ≥ 32 caracteres, gerado pelo env:init. Nunca vai para o web.
LYRICS_REVIEW_SECRET=

# Pasta onde a API guarda as trilhas (voz e instrumental) das referências prontas (sdd-016),
# ~5–8 MB por música: `<pasta>/<songId>/<stemsKey>/{vocals,instrumental}.m4a`. Opcional:
# relativa à raiz do repo; este é o padrão (ignorado pelo Git). No compose é um volume.
SONG_STEMS_DIR=.data/stems

# ─── Web (validado em apps/web/lib/env.public.ts e lib/env.server.ts) ───────────
# URL da API usada pelo browser. Pública: vai para o bundle no `next build`, então
# mudar o valor exige rebuild. Nunca coloque segredo em variável NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:3333

# URL da API usada pelo servidor do Next (Server Components). Opcional: sem ela, usa
# NEXT_PUBLIC_API_URL. No compose vira http://api:3333.
API_INTERNAL_URL=http://localhost:3333

# ─── Worker (validado em apps/worker/app/config.py) ─────────────────────────────
# Chave da API da OpenAI para transcrever a voz com o `whisper-1` (sdd-014), em vez do Whisper
# local na CPU. Opcional: sem ela (ou vazia) o worker usa o Whisper local, que também é a
# reserva quando a OpenAI falha. Segredo: só o worker lê; nunca vai para a API nem para o web.
# Crie em platform.openai.com e ponha um limite mensal de gasto no projeto.
OPENAI_API_KEY=

# Device do Demucs e do MMS_FA (sdd-016): `auto` (padrão) usa a GPU do Mac (`mps`) quando
# existe, senão a CPU; `cpu` ou `mps` forçam (`mps` numa máquina sem MPS derruba o boot).
# O crepe e o Whisper local ficam sempre em CPU. No Docker (Linux) `auto` vira `cpu`.
WORKER_DEVICE=auto
